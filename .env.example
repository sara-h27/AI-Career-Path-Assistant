# Copy to .env. Never commit the real .env file.
# In the UI choose API mode, then click Start / Apply settings.
LLM_PROTOCOL=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# json_schema | json_object | prompt_json
LLM_RESPONSE_FORMAT=json_object
MAX_SESSION_TOKENS=30000
# Optional actual gateway prices, USD per million tokens. Blank = unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Team taxonomy path, relative to project root or absolute.
TAXONOMY_PATH=
