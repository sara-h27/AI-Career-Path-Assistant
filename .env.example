# Copy to .env (never commit it). Leave OPENAI_API_KEY empty to run the offline demo.
# OpenAI-compatible gateway (the hackathon gateway): LLM_PROTOCOL=openai and its base URL.
# Metis Gemini native: LLM_PROTOCOL=gemini, OPENAI_BASE_URL=https://api.metisai.ir, OPENAI_MODEL=<exact model id>.
LLM_PROTOCOL=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# json_schema | json_object | prompt_json
LLM_RESPONSE_FORMAT=json_object
MAX_SESSION_TOKENS=60000
# Gateway prices in USD per million tokens (blank = cost shown as unknown).
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Vector store for position retrieval. docker compose sets this to the qdrant service;
# if unreachable the app falls back to Qdrant's in-process mode.
QDRANT_URL=http://localhost:6333
# fastembed (local multilingual model, default) | gateway (uses EMBEDDING_MODEL on the gateway)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=text-embedding-3-small
