{
  "$defs": {
    "ConceptClaim": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "evidence": {
          "description": "Exact quote from latest normalized user message",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "evidence"
      ],
      "title": "ConceptClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target_role": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Role"
    },
    "target_level": {
      "anyOf": [
        {
          "enum": [
            "junior",
            "mid",
            "senior"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Level"
    },
    "current_level": {
      "anyOf": [
        {
          "enum": [
            "beginner",
            "junior",
            "mid",
            "senior"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Level"
    },
    "education": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Education"
    },
    "experience_years": {
      "anyOf": [
        {
          "maximum": 80,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Experience Years"
    },
    "added_concepts": {
      "items": {
        "$ref": "#/$defs/ConceptClaim"
      },
      "maxItems": 100,
      "title": "Added Concepts",
      "type": "array"
    },
    "removed_concepts": {
      "items": {
        "$ref": "#/$defs/ConceptClaim"
      },
      "maxItems": 100,
      "title": "Removed Concepts",
      "type": "array"
    },
    "skills_assessed": {
      "title": "Skills Assessed",
      "type": "boolean"
    },
    "user_confirmed_final": {
      "title": "User Confirmed Final",
      "type": "boolean"
    }
  },
  "title": "TurnExtractionSchema",
  "type": "object",
  "required": [
    "target_role",
    "target_level",
    "current_level",
    "education",
    "experience_years",
    "added_concepts",
    "removed_concepts",
    "skills_assessed",
    "user_confirmed_final"
  ]
}