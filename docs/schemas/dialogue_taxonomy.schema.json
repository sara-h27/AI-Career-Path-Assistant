{
  "$defs": {
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[^\\n\\r<>]+$",
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Concept",
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[^\\n\\r<>]+$",
          "title": "Label",
          "type": "string"
        },
        "domain": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "requirements": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "junior",
              "mid",
              "senior"
            ]
          },
          "title": "Requirements",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "domain",
        "requirements"
      ],
      "title": "Role",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/Role"
      },
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/Concept"
      },
      "minItems": 1,
      "title": "Concepts",
      "type": "array"
    }
  },
  "required": [
    "version",
    "roles",
    "concepts"
  ],
  "title": "Taxonomy",
  "type": "object"
}